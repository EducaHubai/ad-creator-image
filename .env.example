# Variables de RUNTIME del server (server.js) — sin prefijo VITE_: ninguna se
# embebe en el bundle ni llega al navegador. Rotarlas en Coolify no requiere rebuild.

# Proxy LLM: server.js las usa para reenviar /api/llm/chat y /api/llm/images
# hacia LiteLLM. LITELLM_API_KEY es una key virtual de LiteLLM (no una key raw de
# OpenAI/Google). Modelos que el proxy debe exponer (mismos que course-cover-engine):
# gemini-3.5-flash-lite (texto), gemini-3-pro-image y gemini-3.1-flash-image
# (imagen) y gpt-image-2.5-sunburst (imagen OpenAI, litellm_params.model:
# openai/gpt-image-2.5-sunburst). Ese último también va por LiteLLM en modo
# Batch ("managed batches": /v1/files + /v1/batches con esta misma key), lo que
# requiere Postgres en el proxy. No hay key de OpenAI en la app.
LITELLM_API_KEY=sk-your-litellm-virtual-key-here
LITELLM_BASE_URL=https://litellm-hel.hawkings.educaedtech.tools

# Supabase: SERVICE key (server-side only, igual que course-cover-engine).
# El front nunca la ve — habla con /api/db/* y /api/storage/*.
# En Coolify (produccion): SUPABASE_URL=http://kong:8000 con la app conectada a
# la Predefined Network (Kong no se expone a internet).
SUPABASE_URL=https://your-supabase-url.example.com
SUPABASE_SERVICE_KEY=your-service-role-key-here
# La instancia de Supabase es compartida entre apps: las tablas de esta app
# viven en su propio schema (no en public). OBLIGATORIA y sin valor por defecto:
# el server FALLA al arrancar si falta y Supabase está configurado. Ese schema
# DEBE estar expuesto en PGRST_DB_SCHEMAS del contenedor `rest`; ver migrations/0005.
SUPABASE_SCHEMA=ad_creator_image

# Key nativa de Google AI Studio — solo para el modo Batch de imágenes con
# modelos Gemini (50% más barato, asíncrono). El modo Rápido no la necesita, y
# el Batch con gpt-image-2.5-sunburst tampoco (va por LiteLLM).
GEMINI_API_KEY=

# Basic Auth delante de toda la app (opcional pero recomendado si es pública).
# APP_USER=admin
# APP_PASSWORD=change-me

# PORT=3000
